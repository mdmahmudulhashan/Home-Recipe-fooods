rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 1. Default Deny All Paths (No Insecure Wildcards)
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // 2. Role & Department Lookup Helpers via Firestore
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidEmployeeId(id) {
      return id.size() >= 1 && id.size() <= 64;
    }

    // 3. Employee Profile Photos: employee-photos/{employeeId}/{fileName}
    match /employee-photos/{employeeId}/{fileName} {
      allow read: if true;
      allow create, update: if isValidEmployeeId(employeeId) &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if isSignedIn();
    }

    // 4. Employee Official Documents: employee-documents/{employeeId}/{fileName}
    match /employee-documents/{employeeId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isValidEmployeeId(employeeId) &&
        request.resource.size <= 10 * 1024 * 1024 &&
        request.resource.contentType.matches('(application/pdf|image/jpeg|image/png|image/webp)');
      allow delete: if isSignedIn();
    }

    // 5. Company Brand Assets (Logo, Favicons, Banners): company-assets/{fileName}
    match /company-assets/{fileName} {
      allow read: if true;
      allow create, update: if request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp|svg\\+xml)');
      allow delete: if isSignedIn();
    }

    // 6. Authorized Signatures: signatures/{fileName}
    match /signatures/{fileName} {
      allow read: if true;
      allow create, update: if request.resource.size <= 3 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isSignedIn();
    }

    // 7. General Uploads & Product Images: uploads/{allPaths=**}
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.resource.size <= 10 * 1024 * 1024;
      allow delete: if isSignedIn();
    }
  }
}
